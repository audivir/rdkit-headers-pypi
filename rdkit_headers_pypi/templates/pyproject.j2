[build-system]
requires = ["pdm-backend"]
build-backend = "pdm.backend"

[project]
name = "{{ name }}"
dynamic = ["version"]
description = "{{ description }}"
authors = [{ name = "Tim Hörmann", email = "pypi@audivir.de" }]
readme = "README.md"
requires-python = ">=3.9"
license = "{{ license }}"
license-files = ["LICENSE", "NOTICE"]
{%- if dependencies %}
dependencies = [
    {{ '"' + '",\n    "'.join(dependencies) + '"' }}
]
{%- endif %}

[project.urls]
Homepage = "https://github.com/audivir/rdkit-headers-pypi"
Repository = "https://github.com/audivir/rdkit-headers-pypi"
Issues = "https://github.com/audivir/rdkit-headers-pypi/issues"

[tool.pdm.version]
source = "file"
path = "{{ name.replace('-', '_') }}/__init__.py"
